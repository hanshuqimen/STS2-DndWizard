<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Version>0.4.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GameDir Condition="'$(GameDir)' == ''">C:\Games\Slay the Spire 2</GameDir>
    <GameData>$(GameDir)\data_sts2_windows_x86_64</GameData>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Reference Include="sts2"><HintPath>$(GameData)\sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameData)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameData)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BaseLib"><HintPath>$(GameDir)\mods\BaseLib\BaseLib.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
